# Dodo Payments configuration
#
# Real integration mode kicks in when DODO_API_KEY is set; otherwise (or with
# SIMULATE_PAYMENTS=1) the app falls back to instant simulated purchases.
#
# Get your test API key + webhook secret from the Dodo Payments dashboard
# (test mode): Settings → API keys / Webhooks.

# Test-mode API key (starts with something like `sk_test_...` or raw bearer token).
DODO_API_KEY=

# "test_mode" (default) or "live_mode"
DODO_MODE=test_mode

# Webhook signing secret shown when you configure the webhook endpoint.
# Point your webhook at https://<tunnel>.ngrok.app/api/webhooks/dodo
DODO_WEBHOOK_SECRET=whsec_xxx

# Force the old instant simulated checkout (no Dodo calls) even if a key exists.
# SIMULATE_PAYMENTS=1

# Frontend SDK mode for overlay/inline checkout: "test" or "live"
# (compiled from VITE_DODO_MODE into the client bundle)
VITE_DODO_MODE=test

PORT=8787
CLIENT_ORIGIN=http://localhost:5173