# ---------------------------------------------------------------------------
# Atlas Studio — environment
#
# Copy to `.env` and fill in. The app boots with only MONGODB_URI set: without
# a Dodo API key it runs in simulate mode (instant purchases, local license
# keys) so the whole demo works offline.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# MongoDB connection string. Use an Atlas cluster (or any replica set) —
# the wallet and guest-linking flows use multi-document transactions, which
# a standalone mongod does not support.
MONGODB_URI=

# --- Dodo Payments ---------------------------------------------------------
# Test-mode API key from the Dodo dashboard (Settings → API keys).
# Leave blank to run in simulate mode.
DODO_API_KEY=

# "test_mode" (default) or "live_mode"
DODO_MODE=test_mode

# Dodo product ids (Settings → Products), one per catalog tier. Create a
# product with matching price/billing interval for each tier, then paste its
# id here. In simulate mode they are never sent anywhere.
DODO_PRODUCT_PROMPT_PACK_5=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_STANDARD=
DODO_PRODUCT_PRO=
DODO_PRODUCT_USAGE_METERED=
DODO_PRODUCT_SEAT_MONTHLY=
DODO_PRODUCT_TOPUP_100=
DODO_PRODUCT_TOPUP_500=
DODO_PRODUCT_STUDIO_PASS_LIFETIME=

# Webhook signing secret from the Dodo dashboard. The endpoint the adapter
# mounts is POST /api/auth/dodopayments/webhooks — point your tunnel there.
DODO_WEBHOOK_SECRET=whsec_xxx

# Set to 1 to force simulate mode even when DODO_API_KEY is present.
SIMULATE_PAYMENTS=

# --- Better Auth -----------------------------------------------------------
# Session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Public (compiled into the browser bundle) -----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode for the dodopayments-checkout overlay/inline SDK: "test" or "live"
NEXT_PUBLIC_DODO_MODE=test

# Optional Dodo-hosted storefront preview, linked from the pricing page.
# Leave blank to hide the link.
NEXT_PUBLIC_DODO_STORE_URL=
